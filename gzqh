#!/usr/bin/env bash
# gzqh - nft 四层故障切换管理菜单
# 所有切换/状态逻辑都在 /opt/cf_ss_failover.py 里，这里只做交互和配置编辑。
set -u

SERVICE="ss-failover"
SERVICE_FILE="/etc/systemd/system/ss-failover.service"
SCRIPT_FILE="/opt/cf_ss_failover.py"
STATE_DIR="/opt/ss-failover"
LOG_FILE="$STATE_DIR/failover.log"
LOGROTATE_FILE="/etc/logrotate.d/ss-failover"
REPO_TARBALL="https://github.com/saotu/gzqh-portable/archive/refs/heads/main.tar.gz"

color() { printf '\033[%sm%s\033[0m\n' "$1" "$2"; }
info() { color 36 "$1"; }
ok() { color 32 "$1"; }
warn() { color 33 "$1"; }
err() { color 31 "$1"; }
pause() { read -rp $'\n按回车继续...' _ || true; }
need_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || { err "请用 root 运行"; exit 1; }; }
fo() { python3 "$SCRIPT_FILE" "$@"; }
installed() { [[ -f "$SCRIPT_FILE" && -f "$SERVICE_FILE" ]]; }

get_env() {
  local key="$1" default="${2:-}" val
  val=$(grep -E "^Environment=${key}=" "$SERVICE_FILE" 2>/dev/null | tail -1 | sed -E "s/^Environment=${key}=//")
  printf '%s' "${val:-$default}"
}

# set_env KEY=VAL [KEY=VAL ...]  —— 校验后重写 unit，失败则不改动
set_env() {
  local args=() kv tmp
  for kv in "$@"; do args+=(--set "$kv"); done
  tmp=$(mktemp "${SERVICE_FILE}.XXXXXX") || return 1
  if ! fo render-unit --python "$(command -v python3)" --script "$SCRIPT_FILE" "${args[@]}" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  chmod 0644 "$tmp"
  mv -f "$tmp" "$SERVICE_FILE"
  systemctl daemon-reload
}

service_active() { systemctl is-active --quiet "$SERVICE"; }

# 配置改动后：运行中则重启；未运行则询问是否启动
apply_config() {
  if service_active; then
    systemctl restart "$SERVICE" && ok "已应用并重启服务" || err "服务重启失败，请查看 1) 状态/日志"
  else
    warn "服务当前未运行，新配置会在启动时生效"
    local y
    read -rp "现在启动服务？[y/N]: " y
    if [[ "$y" == "y" || "$y" == "Y" ]]; then
      systemctl enable --now "$SERVICE" >/dev/null 2>&1 && ok "服务已启动" || err "启动失败"
    fi
  fi
}

is_port() { [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }

read_number() { # read_number 提示 当前值 类型(posfloat|posint) -> 输出新值
  local prompt="$1" cur="$2" kind="$3" v
  while true; do
    read -rp "${prompt} [回车保持 ${cur}]: " v
    v=${v:-$cur}
    if [[ "$kind" == posint && "$v" =~ ^[0-9]+$ ]] && (( 10#$v >= 1 )); then printf '%s' "$((10#$v))"; return; fi
    if [[ "$kind" == posfloat && "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk "BEGIN{exit !($v>0)}"; then printf '%s' "$v"; return; fi
    if [[ "$kind" == posint ]]; then err "无效输入：请输入大于等于 1 的整数" >&2; else err "无效输入：请输入大于 0 的数字" >&2; fi
  done
}

show_header() {
  clear
  echo "============================================"
  echo " gzqh - nft 四层故障切换 (入口: $(get_env FORWARD_PORT 10001))"
  echo "============================================"
  if ! installed; then
    warn "组件未完整安装，请先执行: gzqh install"
    return
  fi
  local svc brief mode active target primary
  svc=$(systemctl is-active "$SERVICE" 2>/dev/null || true)
  if [[ "$svc" == "active" ]]; then ok "服务: 运行中"; else warn "服务: 未运行 (${svc:-unknown}) —— 5) 服务控制 里启动"; fi
  brief=$(fo status --brief 2>/dev/null || true)
  if [[ -n "$brief" ]]; then
    IFS='|' read -r mode active target primary <<< "$brief"
    echo "模式: ${mode}    当前线路: ${active} -> ${target}"
    echo "主线: ${primary}"
  fi
  local bl; bl=$(get_env BACKUP_LIST "")
  [[ -z "$bl" ]] && warn "备用线路: 未配置 —— 2) 备用线路 里添加"
  echo
}

# ------------------------------------------------------------ 1 状态/日志
status_page() {
  while true; do
    show_header
    fo status --probe
    echo
    echo "--- 最近 15 行切换日志 ---"
    tail -n 15 "$LOG_FILE" 2>/dev/null || echo "(暂无日志)"
    echo
    echo "l) 实时跟踪日志 (Ctrl+C 退出)   a) 最近 200 行日志"
    echo "s) systemd 状态                 r) 立即轮转日志"
    echo "回车) 刷新   0) 返回"
    local c
    read -rp "请选择: " c
    case "$c" in
      l) trap ':' INT; tail -n 20 -f "$LOG_FILE"; trap - INT ;;
      a) tail -n 200 "$LOG_FILE" 2>/dev/null; pause ;;
      s) systemctl status "$SERVICE" --no-pager -l | sed -n '1,30p'; pause ;;
      r) logrotate -f "$LOGROTATE_FILE" && ok "已轮转"; ls -lh "$STATE_DIR"/failover.log* 2>/dev/null; pause ;;
      0) return ;;
      *) ;;
    esac
  done
}

# ------------------------------------------------------------ 2 备用线路
backup_menu() {
  while true; do
    show_header
    local list; list=$(get_env BACKUP_LIST "")
    local arr=()
    [[ -n "$list" ]] && IFS=',' read -ra arr <<< "$list"
    echo "备用线路（越靠前优先级越高）："
    local i
    for i in "${!arr[@]}"; do echo "  $((i + 1)). ${arr[$i]}"; done
    [[ ${#arr[@]} -eq 0 ]] && echo "  （空）"
    echo
    echo "1) 添加   2) 删除   3) 置顶   0) 返回"
    local c; read -rp "请选择: " c
    case "$c" in
      1)
        local host port ip
        read -rp "备用 IP 或域名: " host
        read -rp "备用端口: " port
        host=$(printf '%s' "$host" | tr -d '[:space:]')
        if [[ -z "$host" ]] || ! is_port "$port"; then err "IP/域名不能为空，端口需为 1-65535"; pause; continue; fi
        port=$((10#$port))
        if ! ip=$(fo resolve "$host"); then err "无法解析 ${host}"; pause; continue; fi
        [[ "$ip" != "$host" ]] && info "${host} 当前解析为 ${ip}（服务会定期重新解析）"
        local item="${host}:${port}" x
        for x in "${arr[@]}"; do [[ "$x" == "$item" ]] && { warn "已存在：${item}"; pause; continue 2; }; done
        local primary; primary=$(fo status --brief 2>/dev/null | cut -d'|' -f4)
        if [[ "$primary" == "${ip}:${port}" ]]; then err "这就是主线，不能作为备用"; pause; continue; fi
        if set_env "BACKUP_LIST=${list:+${list},}${item}"; then ok "已添加：${item}"; apply_config; fi
        pause ;;
      2)
        [[ ${#arr[@]} -eq 0 ]] && { warn "没有可删除的备用"; pause; continue; }
        local d; read -rp "要删除的编号: " d
        if ! [[ "$d" =~ ^[0-9]+$ ]] || (( 10#$d < 1 || 10#$d > ${#arr[@]} )); then err "编号无效"; pause; continue; fi
        if (( ${#arr[@]} == 1 )); then
          local y; read -rp "删除后将没有备用线路，主线故障时不会切换。确认？[y/N]: " y
          [[ "$y" == "y" || "$y" == "Y" ]] || continue
        fi
        local removed="${arr[$((10#$d - 1))]}"
        unset 'arr[$((10#$d - 1))]'
        local nl; nl=$(IFS=','; echo "${arr[*]}")
        if set_env "BACKUP_LIST=${nl}"; then ok "已删除：${removed}（若流量正在走它，服务会自动换线）"; apply_config; fi
        pause ;;
      3)
        (( ${#arr[@]} < 2 )) && { warn "至少两条备用才需要调整优先级"; pause; continue; }
        local t; read -rp "要置顶的编号: " t
        if ! [[ "$t" =~ ^[0-9]+$ ]] || (( 10#$t < 1 || 10#$t > ${#arr[@]} )); then err "编号无效"; pause; continue; fi
        (( 10#$t == 1 )) && { warn "已是最高优先级"; pause; continue; }
        local top="${arr[$((10#$t - 1))]}" nl="" x
        nl="$top"
        for x in "${arr[@]}"; do [[ "$x" == "$top" ]] || nl="${nl},${x}"; done
        if set_env "BACKUP_LIST=${nl}"; then ok "已置顶：${top}"; apply_config; fi
        pause ;;
      0) return ;;
      *) ;;
    esac
  done
}

# ------------------------------------------------------------ 3 参数设置
change_forward_port() {
  local old new info target_host target_port
  old=$(get_env FORWARD_PORT 10001)
  echo "当前入口端口: ${old}"
  echo "改端口时会读取新端口已有的 nfter/nft 转发目标作为主线，并移除旧入口 ${old} 的转发规则。"
  read -rp "新入口端口 [回车取消]: " new
  [[ -n "$new" ]] || return
  if ! is_port "$new"; then err "端口无效，必须是 1-65535"; pause; return; fi
  new=$((10#$new))
  if ! info=$(fo take-port "$new" --dry-run); then pause; return; fi
  target_host=$(sed -n '1p' <<< "$info")
  target_port=$(sed -n '2p' <<< "$info")
  echo
  echo "新入口 ${new} 读取到的主线目标：${target_host}:${target_port}"
  echo "匹配规则："; sed -n '3,$p' <<< "$info"
  echo
  local y; read -rp "确认接管入口 ${new} 并删除旧入口 ${old} 的规则？输入 y 确认: " y
  [[ "$y" == "y" ]] || return
  local was_active=0
  service_active && was_active=1
  systemctl stop "$SERVICE" 2>/dev/null || true
  if ! fo take-port "$new"; then
    err "接管失败，规则未改动"
    (( was_active )) && systemctl start "$SERVICE"
    pause; return
  fi
  set_env "FORWARD_PORT=${new}"
  (( was_active )) && systemctl start "$SERVICE"
  ok "入口端口已改为 ${new}，主线 ${target_host}:${target_port}"
  (( was_active )) || warn "服务未运行，需要时到 5) 服务控制 启动"
  pause
}

change_primary() {
  local cur; cur=$(fo status --brief 2>/dev/null | cut -d'|' -f4)
  echo "当前主线: ${cur}"
  echo "通常不需要手动改：服务会在首次运行时读取入口规则作为主线，用 nfter 改目标也会自动跟随。"
  local v; read -rp "新主线 IP:端口 [回车取消]: " v
  [[ -n "$v" ]] || return
  fo set-primary "$v" && ok "主线已设置为 ${v}"
  pause
}

param_menu() {
  while true; do
    show_header
    printf '1) 入口端口           %s\n' "$(get_env FORWARD_PORT 10001)"
    printf '2) 主线目标           %s\n' "$(fo status --brief 2>/dev/null | cut -d'|' -f4)"
    printf '3) 故障检测           每 %ss 探测，连续失败 %s 次切走，连接超时 %ss\n' \
      "$(get_env CHECK_INTERVAL 0.4)" "$(get_env FAIL_THRESHOLD 1)" "$(get_env CHECK_TIMEOUT 0.06)"
    printf '4) 恢复检测           走备用时每 %ss 探测，主线连续 OK %s 次切回\n' \
      "$(get_env BACKUP_CHECK_INTERVAL 1)" "$(get_env RECOVER_THRESHOLD 10)"
    echo "0) 返回"
    local c; read -rp "请选择: " c
    case "$c" in
      1) show_header; change_forward_port ;;
      2) show_header; change_primary ;;
      3)
        show_header
        local ci ft ct
        ci=$(read_number "探测间隔(秒)" "$(get_env CHECK_INTERVAL 0.4)" posfloat)
        ft=$(read_number "连续失败次数" "$(get_env FAIL_THRESHOLD 1)" posint)
        ct=$(read_number "TCP 连接超时(秒)" "$(get_env CHECK_TIMEOUT 0.06)" posfloat)
        set_env "CHECK_INTERVAL=$ci" "FAIL_THRESHOLD=$ft" "CHECK_TIMEOUT=$ct" && apply_config
        pause ;;
      4)
        show_header
        local bi rt
        bi=$(read_number "走备用时探测间隔(秒)" "$(get_env BACKUP_CHECK_INTERVAL 1)" posfloat)
        rt=$(read_number "主线连续 OK 次数后切回" "$(get_env RECOVER_THRESHOLD 10)" posint)
        set_env "BACKUP_CHECK_INTERVAL=$bi" "RECOVER_THRESHOLD=$rt" && apply_config
        pause ;;
      0) return ;;
      *) ;;
    esac
  done
}

# ------------------------------------------------------------ 4 切换模式
mode_menu() {
  show_header
  echo "1) 自动（故障切备用，恢复后切回）"
  echo "2) 锁定主线（不自动切走）"
  echo "3) 锁定某条备用（不自动切回）"
  echo "0) 返回"
  local c; read -rp "请选择: " c
  case "$c" in
    1) fo mode auto && ok "已切换为自动模式" ;;
    2) fo mode hold-primary && ok "已锁定主线" ;;
    3)
      local list arr=() i n
      list=$(get_env BACKUP_LIST "")
      [[ -z "$list" ]] && { warn "没有备用线路"; pause; return; }
      IFS=',' read -ra arr <<< "$list"
      for i in "${!arr[@]}"; do echo "  $((i + 1))) ${arr[$i]}"; done
      read -rp "锁定到第几条 [1]: " n
      n=${n:-1}
      fo mode hold-backup "$n" && ok "已锁定备用 #${n}"
      ;;
    *) return ;;
  esac
  service_active || warn "注意：服务未运行，锁定已生效到规则，但不会持续监控"
  pause
}

# ------------------------------------------------------------ 5 服务控制
service_menu() {
  while true; do
    show_header
    echo "1) 启动   2) 停止   3) 重启   4) systemd 状态   5) 立即检测一次   0) 返回"
    local c; read -rp "请选择: " c
    case "$c" in
      1) if fo check-config; then systemctl enable --now "$SERVICE" >/dev/null 2>&1; systemctl status "$SERVICE" --no-pager -l | sed -n '1,15p'; fi; pause ;;
      2) systemctl stop "$SERVICE"; ok "已停止（开机仍会自启，如需取消自启请执行 systemctl disable $SERVICE）"; pause ;;
      3) if fo check-config; then systemctl restart "$SERVICE"; systemctl status "$SERVICE" --no-pager -l | sed -n '1,15p'; fi; pause ;;
      4) systemctl status "$SERVICE" --no-pager -l | sed -n '1,30p'; pause ;;
      5) fo once; pause ;;
      0) return ;;
      *) ;;
    esac
  done
}

# ------------------------------------------------------------ 88 / 99
update_self() {
  show_header
  warn "将从 GitHub 下载最新版本覆盖安装，保留当前配置和状态。"
  local ans; read -rp "确认请输入 yes: " ans
  [[ "$ans" == "yes" ]] || return
  (
    set -e
    tmp=$(mktemp -d /tmp/gzqh-update.XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL "$REPO_TARBALL" -o "$tmp/src.tar.gz"
    tar -xzf "$tmp/src.tar.gz" -C "$tmp"
    src=$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -n1)
    [[ -f "$src/install.sh" && -f "$src/gzqh" && -f "$src/cf_ss_failover.py" ]]
    bash "$src/install.sh"
  ) && { ok "更新完成，正在重新打开菜单"; sleep 1; exec /usr/local/bin/gzqh; } || err "更新失败，原版本未受影响"
  pause
}

uninstall_all() {
  show_header
  warn "将卸载 gzqh：删除服务、脚本、状态和日志轮转配置。"
  warn "如果当前在备用线路，会先把入口规则切回主线。"
  local ans; read -rp "确认请输入 yes: " ans
  [[ "$ans" == "yes" ]] || return
  systemctl stop "$SERVICE" 2>/dev/null || true
  [[ -f "$SCRIPT_FILE" ]] && fo restore-primary || true
  systemctl disable "$SERVICE" 2>/dev/null || true
  rm -f "$SERVICE_FILE" "$SERVICE_FILE".bak_* "$SCRIPT_FILE" "$SCRIPT_FILE".bak_* "$LOGROTATE_FILE"
  rm -rf "$STATE_DIR"
  systemctl daemon-reload || true
  systemctl reset-failed "$SERVICE" 2>/dev/null || true
  rm -f /usr/local/bin/gzqh
  ok "已卸载（入口端口的 nft 转发规则保留，指向主线）"
  exit 0
}

main_menu() {
  while true; do
    show_header
    echo "1) 状态 / 日志"
    echo "2) 备用线路（添加/删除/置顶）"
    echo "3) 参数设置（入口端口/主线/检测阈值）"
    echo "4) 切换模式（自动/锁定主线/锁定备用）"
    echo "5) 服务控制（启动/停止/重启/立即检测）"
    echo "88) 一键更新"
    echo "99) 一键卸载"
    echo "0) 退出"
    echo
    local c; read -rp "请选择: " c || exit 0
    if ! installed && [[ "$c" =~ ^[1-5]$ ]]; then err "未安装，请先执行 gzqh install"; pause; continue; fi
    case "$c" in
      1) status_page ;;
      2) backup_menu ;;
      3) param_menu ;;
      4) mode_menu ;;
      5) service_menu ;;
      88) update_self ;;
      99) uninstall_all ;;
      0) exit 0 ;;
      *) ;;
    esac
  done
}

need_root
case "${1:-}" in
  install|repair|update|--install)
    tmp=$(mktemp -d /tmp/gzqh-install.XXXXXX); trap 'rm -rf "$tmp"' EXIT
    curl -fsSL "$REPO_TARBALL" -o "$tmp/src.tar.gz" && tar -xzf "$tmp/src.tar.gz" -C "$tmp" \
      && bash "$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -n1)/install.sh"
    exit $? ;;
  status) fo status --probe; exit $? ;;
  logs) tail -n 50 -f "$LOG_FILE"; exit $? ;;
  once) fo once; exit $? ;;
  "") ;;
  *) echo "用法: gzqh [install|status|logs|once]"; exit 1 ;;
esac
main_menu
